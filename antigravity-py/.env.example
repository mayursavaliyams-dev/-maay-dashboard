# Copy to .env and fill. NEVER commit the real .env.
# PY_TRADE_MODE, not TRADE_MODE. TRADE_MODE arms the Node options bot; this app
# reads its own name so one variable cannot arm two deployables. Setting
# TRADE_MODE=live without PY_TRADE_MODE makes this app REFUSE to start.
PY_TRADE_MODE=paper

# Upstox live data (leave blank to run analytics offline / greeks only)
UPSTOX_ACCESS_TOKEN=

# Engine defaults (mirror the Node config-overrides)
STRANGLE_ENGINE_ENABLED=true
STRANGLE_FORCE_CONDOR=true
STRANGLE_CAPITAL=700000
NIFTY_DIRECTIONAL_AUTO=false
SENSEX_DIRECTIONAL_AUTO=false
MAX_DAILY_LOSS_PERCENT=5

# Latency knobs (ms)
UPSTOX_CHAIN_CACHE_MS=2500
UPSTOX_PRICE_CACHE_MS=1500
