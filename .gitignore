# ── archives written by the capture path (2026-08-12) ────────────────────────
# raw-journal grows ~3.7 MB/hour, ~88 MB/day: it is the WORM record the warehouse
# is rebuilt FROM, and it belongs on disk and in backups, never in git history
# where it can never be removed. data/warehouse/ is ignored for the same reason.
data/raw-journal/
# per-minute "were we watching" records; small, but derived and regenerated daily
data/capture-coverage/
# vendor quote/bar cache for the screener — 5.9 MB and re-fetchable in 40 seconds
data/screener-cache.json
data/screener-cache.json.bak
# today's trade counts; machine state, not source
data/trades-today.json
data/trades-today.json.bak
# route usage measurement, regenerated by the harness
data/route-usage.json
# liveness of the running processes; machine state, regenerated every 15s
data/heartbeats.json
data/heartbeats.json.bak

# scraped ProPicks rows; the tracked template is data/investing-propicks.example.json
data/investing-propicks.json

# headless-browser profile dirs left behind by the UI layout tests (~60 MB)
.tmp-ptr-*/

# screenshots taken while verifying UI work — evidence for a review, not source
artifacts/
