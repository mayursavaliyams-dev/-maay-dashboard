# Migration rollback snapshots — copies of files git already has in history.
# Committing them duplicates engine source and breaks the perf-budget ratchet
# (git ls-files *.js would count their raw writeFileSync as production code).
backups/
__pycache__/
*.pyc
.pytest_cache/
generated-strategies/

# Raw NSE bhavcopy CSVs (40M, re-fetchable via bt-bhav-fetch.js)
bt-data/bhav/

# Runtime AI advisor signal log (measured hit-rate state)
data/ai-signals.json

# Runtime strangle IV-regime history
data/strangle-iv.json

# ── Repo hygiene (added during full-program cleanup) ──
