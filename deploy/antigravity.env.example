# Copy to /etc/antigravity-bot/antigravity.env on the cloud host.
# Never commit the real file.

APP_ENV=production
BROKER=angel
LIVE_TRADING=false

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_SCRIP_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json

# Optional spot token overrides. Fill only if you want live spot from Angel.
ANGEL_NIFTY_SPOT_TOKEN=
ANGEL_NIFTY_SPOT_EXCHANGE=NSE
ANGEL_NIFTY_SPOT_SYMBOL=NIFTY
ANGEL_BANKNIFTY_SPOT_TOKEN=
ANGEL_BANKNIFTY_SPOT_EXCHANGE=NSE
ANGEL_BANKNIFTY_SPOT_SYMBOL=BANKNIFTY
ANGEL_SENSEX_SPOT_TOKEN=
ANGEL_SENSEX_SPOT_EXCHANGE=BSE
ANGEL_SENSEX_SPOT_SYMBOL=SENSEX

# Trading/risk defaults
PRODUCT_TYPE=MIS
ORDER_TYPE=MARKET
ORDER_VALIDITY=DAY
RISK_FREE_RATE=0.065
DEFAULT_IV=0.18
MIN_ABS_DELTA=0.45
MAX_ABS_DELTA=0.65
MIN_OI_PERCENTILE=0.50
MIN_VOLUME_PERCENTILE=0.50
MAX_ROWS_TO_QUOTE=250

# App storage/log paths on the server
TREND_SIGNAL_FILE=/opt/antigravity-bot/data/trend_signal.json
TRADE_LOG_DIR=/var/log/antigravity-bot/trades
TALLY_QUEUE_FILE=/var/log/antigravity-bot/trades/tally_queue.jsonl
LOG_LEVEL=INFO

# Add your own verification inside the webhook handler if your TradingView
# alerts include a shared secret.
TRADINGVIEW_WEBHOOK_SECRET=change-this-long-random-string

# Tally integration options
# Preferred for cloud-to-office: queue XML in cloud and let a local office agent
# pull it into http://localhost:9000. If using Tailscale, set this to the
# office PC's Tailscale IP, for example http://100.x.y.z:9000.
TALLY_MODE=queue
TALLY_URL=http://localhost:9000
TALLY_AGENT_TOKEN=change-this-long-random-string
TALLY_DEBIT_LEDGER=Options Trading
TALLY_CREDIT_LEDGER=Angel One Broker
