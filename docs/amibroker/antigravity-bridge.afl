// ============================================================================
//  antigravity-bridge.afl  —  AmiBroker → Antigravity bot signal sender  (v2, GET)
//
//  Sends via AmiBroker's NATIVE InternetOpenURL (a GET) to the bot's push endpoint:
//    GET /api/amibroker/push-signal?signal=CALL|PUT|WAIT&instrument=NIFTY&confidence=..
//        &strike=..&price=..&strategy=..&barId=..
//  No curl, no ShellExecute, no console flash, no quote-escaping. Verified accepted.
//
//  The bot needs the `signal` field = CALL / PUT / WAIT (it REJECTS action=BUY/SELL).
//
//  >>> FIRST-RUN VERIFICATION <<<
//  TEST_MODE is ON below — it force-sends a CALL on every new bar so you can confirm the
//  pipe. Apply this to a NIFTY chart (or Analysis > Scan, Auto-Repeat RT) and watch
//  GET http://127.0.0.1:3000/api/amibroker/status  →  signalsReceived should climb.
//  Once you see it climbing, set  TEST_MODE = False  and use your real signal logic.
//
//  Works in a Chart pane OR Analysis Scan/Exploration (no action-type gate).
// ============================================================================

// ---- CONFIG ---------------------------------------------------------------
BOT_HOST    = "127.0.0.1:3000";   // bot host:port. Same PC = 127.0.0.1. Else = bot LAN IP.
INSTRUMENT  = "NIFTY";            // NIFTY | SENSEX | BANKNIFTY (auto-detected below)
STRIKE_STEP = 50;
SEND_WAIT   = False;              // also send WAIT bars?
TEST_MODE   = True;               // <<< force-send to verify the pipe; set False when confirmed

// auto-detect instrument from the symbol
nm = StrToUpper(Name());
if (StrFind(nm, "BANKNIFTY")) { INSTRUMENT = "BANKNIFTY"; STRIKE_STEP = 100; }
else if (StrFind(nm, "SENSEX")) { INSTRUMENT = "SENSEX"; STRIKE_STEP = 100; }
else if (StrFind(nm, "NIFTY"))  { INSTRUMENT = "NIFTY";  STRIKE_STEP = 50;  }

// ---- SIGNAL LOGIC (replace with your own) ---------------------------------
e9  = EMA(Close, 9);
e21 = EMA(Close, 21);
goLong  = Cross(e9, e21);
goShort = Cross(e21, e9);

sig  = "WAIT";
conf = 60;
if (LastValue(goLong))  { sig = "CALL"; conf = 75; }
if (LastValue(goShort)) { sig = "PUT";  conf = 75; }

if (TEST_MODE) { sig = "CALL"; conf = 66; }   // verification override

px     = LastValue(Close);
strike = round(px / STRIKE_STEP) * STRIKE_STEP;

// ---- SEND via native GET (once per new bar) -------------------------------
curBar   = LastValue(BarIndex());
lastKey  = "ag_lastbar_" + Name();
lastSent = Nz(StaticVarGet(lastKey), -1);
fresh    = curBar != lastSent;
doSend   = fresh AND (sig != "WAIT" OR SEND_WAIT OR TEST_MODE);

if (doSend)
{
    url = "http://" + BOT_HOST + "/api/amibroker/push-signal?signal=" + sig +
          "&instrument=" + INSTRUMENT +
          "&confidence=" + NumToStr(conf, 0, False) +
          "&strike="     + NumToStr(strike, 0, False) +
          "&price="      + NumToStr(px, 2, False) +
          "&strategy=AFL&barId=" + NumToStr(curBar, 0, False);

    ih = InternetOpenURL(url);
    if (ih)
    {
        resp = "";
        chunk = InternetReadString(ih);
        while (chunk != "") { resp = resp + chunk; chunk = InternetReadString(ih); }
        InternetClose(ih);
        StaticVarSet(lastKey, curBar);
        _TRACE("Antigravity OK → " + sig + " " + INSTRUMENT + " " + NumToStr(strike,0) + "  resp=" + resp);
    }
    else
    {
        _TRACE("Antigravity FAIL → InternetOpenURL could not reach " + url +
               "  (check BOT_HOST, that the server is running, and Windows firewall)");
    }
}

// ---- chart cosmetics ------------------------------------------------------
Plot(Close, "Close", colorDefault, styleCandle);
Plot(e9,  "EMA9",  colorYellow);
Plot(e21, "EMA21", colorAqua);
PlotShapes(goLong  * shapeUpArrow,   colorGreen, 0, Low,  -12);
PlotShapes(goShort * shapeDownArrow, colorRed,   0, High,  12);
Title = "Antigravity bridge v2 · " + INSTRUMENT + " · signal=" + sig +
        " conf=" + NumToStr(conf,0) + " strike=" + NumToStr(strike,0) +
        WriteIf(TEST_MODE, " · TEST_MODE ON (force CALL)", "");
