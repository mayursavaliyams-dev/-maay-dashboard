# ============================================================
# Antigravity STOCK Bot — Configuration
# Copy to .env and fill in values. Never commit .env.
# Cash equity (delivery + intraday MIS), NSE. Mirrors the options
# bot but trades stock symbols directly (no strikes / no premium).
# ============================================================

# --- Broker (Dhan) -------------------------------------------
BROKER=dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_BASE_URL=https://api.dhan.co

# --- Mode ----------------------------------------------------
# paper = simulated fills (default). live = real broker orders.
TRADE_MODE=paper
# Live orders NEVER auto-place unless this is true. Default: confirm each order.
LIVE_AUTO_CONFIRM=false
# Master switch + per-symbol overrides (RELIANCE_AUTO_ENABLED=true etc.)
AUTO_TRADE_ENABLED=false
BOT_AUTOSTART=true

# --- Capital & risk ------------------------------------------
CAPITAL_TOTAL=100000
# Risk per trade as % of available capital (drives qty via SL distance)
RISK_PER_TRADE_PCT=2
# Cap a single position's notional at this % of capital
MAX_POSITION_PCT=25
# Stop-loss as % BELOW entry price (price points, not premium)
STOP_LOSS_PERCENT=1
# Target as % ABOVE entry price
TARGET_PERCENT=2
# Trailing: once price is up this %, start trailing
TRAIL_AFTER_PERCENT=1
# Lock this % of peak gain once trailing is active
TRAIL_LOCK_PERCENT=60
# Slippage applied to BOTH paper and live fills (parity with backtest)
SLIPPAGE_PERCENT=0.1
# Half-compound: fraction of profit reinvested (0.5=half, 1.0=full)
PROFIT_REINVEST_PCT=0.5

# --- Halt layers (all on) ------------------------------------
MAX_DAILY_LOSS_PERCENT=3
MAX_CONSECUTIVE_LOSSES=8
MAX_DRAWDOWN_PERCENT=20
MAX_TRADES_PER_DAY=3

# --- Strategy & timing (IST) ---------------------------------
# Selectable strategy (same code path for live + backtest):
#   orb | ema-pullback | vwap-reversion | gap-and-go
STRATEGY=orb
# ORB = opening range breakout. Range built over the first N minutes.
ORB_RANGE_MINUTES=15
# EMA pullback params
EMA_FAST=9
EMA_SLOW=21
EMA_PULLBACK_PCT=0.3
EMA_PULLBACK_LOOKBACK=5
# VWAP reversion params (require both % and ATR stretch)
VWAP_DEV_PCT=0.6
VWAP_DEV_ATR=1.5
# Gap-and-go params
GAP_PCT=0.4
GAP_MAX_ENTRY_MIN=60
# Volume confirmation: require current vol >= avg * this multiple
VOLUME_CONFIRM_MULT=1.4
ENTRY_WINDOW_START=09:31
ENTRY_WINDOW_END=14:30
SQUARE_OFF_TIME=15:15
# Comma-separated NSE symbols (liquid large-caps).
WATCHLIST=RELIANCE,HDFCBANK,INFY,TCS,ICICIBANK

# --- Server --------------------------------------------------
PORT=3100
NODE_ENV=development

# --- Telegram alerts (optional) ------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
