{
  "name": "antigravity-sensex-bot",
  "version": "2.0.0",
  "description": "Antigravity AI Bot - SENSEX Live Trading System (Dhan HQ)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/run.js",
    "preflight": "node preflight.js",
    "preflight:registry": "node preflight-registry.js",
    "analytics:api": "python -m uvicorn options_algo_api:app --host 0.0.0.0 --port 8091",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop antigravity-bot",
    "pm2:restart": "pm2 restart antigravity-bot",
    "pm2:logs": "pm2 logs antigravity-bot",
    "pm2:status": "pm2 status",
    "gen:instrument-meta": "node scripts/gen-instrument-meta.js",
    "perf:report": "node scripts/perf-report.js",
    "export:engine": "node scripts/export-engine.js"
  },
  "keywords": [
    "sensex",
    "options",
    "trading",
    "expiry",
    "antigravity",
    "dhan",
    "ai-bot",
    "live-trading"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^2.6.7",
    "redis": "^3.1.2",
    "ws": "^8.20.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "puppeteer-core": "^25.4.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
