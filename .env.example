# ============================================================
# Antigravity Bot — Configuration
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# --- Dhan API ------------------------------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional: override base URL (default https://api.dhan.co)
DHAN_BASE_URL=https://api.dhan.co

# --- Live execution and risk management ----------------------
MAX_TRADES_PER_DAY=2
# Charge-aware guard: expected gain at target must be ≥ this × round-trip cost,
# else the trade is skipped. 0 = off.
MIN_EDGE_OVER_CHARGES=0
CAPITAL_PER_TRADE_PERCENT=5
# Strike offset from ATM: 0=ATM, 1=OTM1, 2=OTM2...
STRIKE_OFFSET=1
STRIKE_WALK_MAX_OFFSET=8
# Stop-loss: exit when option premium drops this % below entry
STOP_LOSS_PERCENT=35
SLIPPAGE_PERCENT=1
# Target: book full profit when option premium hits this % above entry
# 400% = 5x premium (Friday 5× target preset)
TARGET_PERCENT=400
# Trailing stop: after price reaches this multiple, lock in profit
TRAIL_AFTER_MULTIPLE=2
# Lock this % of peak gain once trailing is active
TRAIL_LOCK_PERCENT=50

# Cutover date when BSE SENSEX weekly expiry moved Fri→Tue
# (approx when SEBI's expiry rationalization took effect)
SENSEX_EXPIRY_CUTOVER=2024-10-28

# --- Server --------------------------------------------------
PORT=3000
NODE_ENV=development
# Optional: when the dashboard is hosted separately, point it at the live API
PUBLIC_API_BASE_URL=

# --- AmiBroker Bridge ----------------------------------------
AMIBROKER_BRIDGE=true
AMIBROKER_API_KEY=antigravity
# Receive/display AmiBroker signals by default. Turn this on only after
# paper validation if AmiBroker should trigger the execution engine.
AMIBROKER_AUTO_TRADE=false
AMIBROKER_MIN_CONFIDENCE=70
AMIBROKER_DEDUPE_SECONDS=30
# Live orders remain blocked unless both TRADE_MODE=live and this flag are true.
AMIBROKER_ALLOW_LIVE=false
# Keep false for production; true is useful only for local smoke tests.
AMIBROKER_ALLOW_AFTER_HOURS=false
# Persist AmiBroker signals by IST trading day for panel history/backtesting.
AMIBROKER_SIGNAL_STORE=true
AMIBROKER_SIGNAL_DIR=data/ami-signals

# --- Telegram Alerts (real-time push to your phone) ----------
# SETUP (30 seconds):
#   1. Open Telegram → search @BotFather → /newbot
#   2. Name: "Antigravity Bot" → Username: "your_antigravity_bot"
#   3. Copy the token → paste below
#   4. Start your bot (open it in Telegram, press START)
#   5. Send it any message, then visit:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#      Copy the chat.id number → paste below
#   6. Set TELEGRAM_ENABLED=true
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alerts sent: Signals, Gamma Blasts, Position SL/Trail/Target,
#              Expiry morning briefing, Daily summary
# Bot commands: /status /blast /position /chain /help

# --- Claude AI Integration -----------------------------------
# SETUP (1 minute):
#   1. Go to https://console.anthropic.com → API Keys → Create key
#   2. Paste the key below
#   3. Set CLAUDE_AI_ENABLED=true
# What it does:
#   • Validates each CALL/PUT signal before entry (vetoes low-quality setups)
#   • Writes human Telegram alerts for every trade event (entry/exit/SL/target)
#   • Generates a 3-bullet end-of-day journal at 15:35 IST (sent to Telegram)
# Cost: <₹1/day at normal trading volume (uses claude-haiku-4-5 — fastest model)
CLAUDE_AI_ENABLED=false
ANTHROPIC_API_KEY=

# --- Browser Alerts ------------------------------------------
ALERT_SOUND=true
ALERT_POPUP=true

# --- Afternoon Gamma Squeeze Strategy -----------------------
# Secondary engine for afternoon session (12:00-14:30 IST).
# Scores entries via: Gamma Blast + BOS/Rejection + Max Pain + EMA Stack + Pattern.
# Capital is SEPARATE from morning engine (Option B: 40% of total).
# Gamma is soft-scored (not a hard gate). Works any day (not expiry-only).
AFTERNOON_ENABLED=false
AFTERNOON_CAPITAL_PCT=40
AFTERNOON_ENTRY_START_HOUR=12
AFTERNOON_ENTRY_START_MINUTE=0
AFTERNOON_ENTRY_END_HOUR=14
AFTERNOON_ENTRY_END_MINUTE=30
AFTERNOON_STOP_LOSS_PERCENT=40
AFTERNOON_TARGET_PERCENT=300
AFTERNOON_TRAIL_AFTER_MULTIPLE=1.5
AFTERNOON_TRAIL_LOCK_PERCENT=60
AFTERNOON_MAX_TRADES=1
# Minutes to wait after an afternoon exit before re-entering (0 = no cooldown).
AFTERNOON_REENTRY_COOLDOWN_MINUTES=0
AFTERNOON_TIME_STOP_MINUTES=20
AFTERNOON_SCORE_THRESHOLD=70
AFTERNOON_MAX_STRIKE_OFFSET=6
# Per-instrument enable flags (override AFTERNOON_ENABLED):
# SENSEX_AFTERNOON_ENABLED=true
# NIFTY_AFTERNOON_ENABLED=true

# --- Auth / public deployment --------------------------------
# Keep false on localhost. Set true before exposing the dashboard publicly.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASS=
AUTH_USERS=[]
AUTH_TOKEN_TTL_HOURS=12
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=

# --- Connector selection -------------------------------------
# auto = prefer UPSTOX_ACCESS_TOKEN, else Kotak/Dhan according to env.
LIVE_CONNECTOR=auto
UPSTOX_ACCESS_TOKEN=
UPSTOX_CHAIN_CACHE_MS=2500
UPSTOX_PRICE_CACHE_MS=1500
UPSTOX_TIMEOUT_MS=6000
KOTAK_CONSUMER_KEY=
KOTAK_ACCESS_TOKEN=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_WS_ENABLED=false
DHAN_SENSEX_SECURITY_ID=
DHAN_NIFTY_SECURITY_ID=
DHAN_BANKNIFTY_SECURITY_ID=
QUOTE_TIMEOUT_MS=6500
REDIS_URL=
PREFLIGHT_BASE=http://127.0.0.1:3000

# --- Global trade/risk controls ------------------------------
TRADE_MODE=paper
BOT_AUTOSTART=false
AUTO_TRADE_ENABLED=false
NIFTY_AUTO_ENABLED=false
SENSEX_AUTO_ENABLED=false
BANKNIFTY_AUTO_ENABLED=false
ORB_MINUTES=15
ENTRY_WINDOW_END_HOUR=14
ENTRY_WINDOW_END_MINUTE=45
MAX_DAILY_LOSS_PERCENT=3
MAX_DRAWDOWN_PERCENT=8
MAX_CONSECUTIVE_LOSSES=3
CAPITAL_TOTAL=100000

# --- Contract lot sizes: EMERGENCY OVERRIDE ONLY ------------------------------
# LEAVE THESE BLANK. The single source of truth is instrument-registry.js, whose
# values are verified against the broker contract master (GET /v2/option/contract).
#
# A non-empty value here OVERRIDES the verified lot size for every engine and
# silently changes realised P&L, because  pnl = (exit - entry) x lots x lotSize.
# Broker-verified as of 2026-07-09:  NIFTY 65 | BANKNIFTY 30 | SENSEX 20.
#
# Set one ONLY when the exchange revises a contract and you have confirmed the new
# size with the broker before instrument-registry.js has been updated. The registry
# logs a warning for as long as an override is active. Then remove it.
NIFTY_LOT_SIZE=
SENSEX_LOT_SIZE=
BANKNIFTY_LOT_SIZE=

PROFIT_REINVEST_PCT=0

# --- Charge model --------------------------------------------
CHARGE_BROKERAGE_PER_ORDER=20
CHARGE_STT_SELL_PCT=0.0625
CHARGE_EXCH_TXN_PCT=0.053
CHARGE_SEBI_PCT=0.0001
CHARGE_GST_PCT=18
CHARGE_STAMP_BUY_PCT=0.003

# --- Paper engines / scanners --------------------------------
STRANGLE_ENGINE_ENABLED=false
STRANGLE_MIN_IVP=50
STRANGLE_IV_PCT_MIN=50
STRANGLE_IV_WINDOW=252
STRANGLE_TP_PCT=50
STRANGLE_STOP_MULT=2
STRANGLE_MAX_OPEN=1
STRANGLE_CAPITAL=100000
STRANGLE_QTY=1
STRANGLE_OTM_PCT=1.5
STRANGLE_WING_PTS=300
STRANGLE_TAILSAFE_PCT=2
STRANGLE_ADJUST_MULT=1.6
STRANGLE_TREND_SKIP_PCT=0.8
STRANGLE_TREND_SMA=20
STRANGLE_FORCE_CONDOR=false
STRANGLE_USE_SIZER=false
SIZER_KELLY_FRACTION=0.25
SIZER_MARGIN_UTIL=0.35
SIZER_MAX_LOTS=4
SIZER_STRANGLE_MARGIN=150000
SIZER_IV_SCALE_FLOOR=0.5
BOUNCE_ENGINE_ENABLED=false
BOUNCE_PCT=0.35
BOUNCE_TARGET_PCT=30
BOUNCE_SL_PCT=20
BOUNCE_QTY=1
BOUNCE_MAX_STRIKES=6

# --- Forward-Test Sharding (Data Collection) -----------------
# Leave empty to log all trades to the global strangle-trades.json.
# Set to an ISO date (YYYY-MM-DD, e.g. 2026-06-22) to START a new forward-test
# window. All trades from that date onward are logged SEPARATELY to:
#   data/forward-test/{date}-strangle.jsonl (one trade per line, newline-delimited)
#   data/forward-test/{date}-stats.json (daily aggregates: count, wins, pnl, margin%)
# This isolates forward-test validation data from the historical log.
# Use: analyze forward-test stats independently, then review before going live.
FORWARD_TEST_DATE_FROM=

GAMMA_BLAST_ENGINE_ENABLED=false
GB_ENGINE_QTY=1
GB_ENGINE_TP_PCT=100
GB_ENGINE_SL_PCT=35
GB_ENGINE_TRAIL_AT=1.5
GB_ENGINE_TRAIL_GB=70
GB_ENGINE_MAX_TRADES=1
GB_ENGINE_SQUAREOFF=15:20

# --- AI agents / confluence ----------------------------------
AI_AGENTS_ENABLED=false
AGENTS_INSTRUMENTS=NIFTY,SENSEX
AGENTS_QTY=1
AGENTS_MAX_TRADES=2
AGENTS_MAX_SELL_TRADES=1
AGENTS_MAX_DAILY_LOSS=5000
AGENTS_MIN_PROB=65
AGENTS_LAST_ENTRY=14:45
AGENTS_SQUAREOFF=15:20
AGENTS_TP_PCT=40
AGENTS_SL_PCT=22
AGENTS_TRAIL_AT=1.4
AGENTS_TRAIL_GB=60
AGENTS_SELL_ENABLED=false
AGENTS_IVP_MIN_SELL=50
AGENTS_IVP_MAX_BUY=80
AGENTS_SELL_TP=50
AGENTS_SELL_STOP=160
AGENTS_SHORT_STEPS=2
AGENTS_WING_STEPS=4
CONFLUENCE_LR=0.05
CONFIRMED_HORIZON_MIN=60
CONFIRMED_MIN_MOVE_PCT=0.15
EARLY_MIN_MOVE_PCT=0.12
EARLY_NEAR_ATM_STRIKES=2
PATTERN_SIGNALS_CACHE_MS=10000
TREND_GATE_ENABLED=false
POP_LIVE_ENABLED=false
SENSIBULL_CACHE_MS=30000
AMIBROKER_SIGNAL_TTL_MIN=30

# --- News/events/intel ---------------------------------------
NEWS_REFRESH_SEC=600
NEWS_SOURCES=
VIX_SYMBOL=^INDIAVIX

# --- Python options API / TradingView / Tally ----------------
LIVE_TRADING=false
TRADINGVIEW_WEBHOOK_SECRET=
TALLY_AGENT_TOKEN=
TALLY_QUEUE_FILE=logs/tally_queue.jsonl
TALLY_DEBIT_LEDGER=Options Trading Loss
TALLY_CREDIT_LEDGER=Options Trading Profit
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Backtest controls ---------------------------------------
BACKTEST_INSTRUMENT=SENSEX
BACKTEST_NUM_EXPIRIES=1200
BACKTEST_START_DATE=
BACKTEST_START_YEAR=2003
DAILY_BACKTEST_DAYS=200
DAILY_BACKTEST_START=
