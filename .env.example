# ============================================================
# Antigravity Bot — Configuration
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# --- Dhan API ------------------------------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional: override base URL (default https://api.dhan.co)
DHAN_BASE_URL=https://api.dhan.co

# --- Live execution and risk management ----------------------
MAX_TRADES_PER_DAY=2
# Charge-aware guard: expected gain at target must be ≥ this × round-trip cost,
# else the trade is skipped. 0 = off.
MIN_EDGE_OVER_CHARGES=0
CAPITAL_PER_TRADE_PERCENT=5
# Strike offset from ATM: 0=ATM, 1=OTM1, 2=OTM2...
STRIKE_OFFSET=1
# Stop-loss: exit when option premium drops this % below entry
STOP_LOSS_PERCENT=35
# Target: book full profit when option premium hits this % above entry
# 400% = 5x premium (Friday 5× target preset)
TARGET_PERCENT=400
# Trailing stop: after price reaches this multiple, lock in profit
TRAIL_AFTER_MULTIPLE=2
# Lock this % of peak gain once trailing is active
TRAIL_LOCK_PERCENT=50

# Cutover date when BSE SENSEX weekly expiry moved Fri→Tue
# (approx when SEBI's expiry rationalization took effect)
SENSEX_EXPIRY_CUTOVER=2024-10-28

# --- Server --------------------------------------------------
PORT=3000
NODE_ENV=development
# Optional: when the dashboard is hosted separately, point it at the live API
PUBLIC_API_BASE_URL=

# --- AmiBroker Bridge ----------------------------------------
AMIBROKER_BRIDGE=true
AMIBROKER_API_KEY=antigravity
# Receive/display AmiBroker signals by default. Turn this on only after
# paper validation if AmiBroker should trigger the execution engine.
AMIBROKER_AUTO_TRADE=false
AMIBROKER_MIN_CONFIDENCE=70
AMIBROKER_DEDUPE_SECONDS=30
# Live orders remain blocked unless both TRADE_MODE=live and this flag are true.
AMIBROKER_ALLOW_LIVE=false
# Keep false for production; true is useful only for local smoke tests.
AMIBROKER_ALLOW_AFTER_HOURS=false
# Persist AmiBroker signals by IST trading day for panel history/backtesting.
AMIBROKER_SIGNAL_STORE=true
AMIBROKER_SIGNAL_DIR=data/ami-signals

# --- Telegram Alerts (real-time push to your phone) ----------
# SETUP (30 seconds):
#   1. Open Telegram → search @BotFather → /newbot
#   2. Name: "Antigravity Bot" → Username: "your_antigravity_bot"
#   3. Copy the token → paste below
#   4. Start your bot (open it in Telegram, press START)
#   5. Send it any message, then visit:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#      Copy the chat.id number → paste below
#   6. Set TELEGRAM_ENABLED=true
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alerts sent: Signals, Gamma Blasts, Position SL/Trail/Target,
#              Expiry morning briefing, Daily summary
# Bot commands: /status /blast /position /chain /help

# --- Claude AI Integration -----------------------------------
# SETUP (1 minute):
#   1. Go to https://console.anthropic.com → API Keys → Create key
#   2. Paste the key below
#   3. Set CLAUDE_AI_ENABLED=true
# What it does:
#   • Validates each CALL/PUT signal before entry (vetoes low-quality setups)
#   • Writes human Telegram alerts for every trade event (entry/exit/SL/target)
#   • Generates a 3-bullet end-of-day journal at 15:35 IST (sent to Telegram)
# Cost: <₹1/day at normal trading volume (uses claude-haiku-4-5 — fastest model)
CLAUDE_AI_ENABLED=false
ANTHROPIC_API_KEY=

# --- Browser Alerts ------------------------------------------
ALERT_SOUND=true
ALERT_POPUP=true

# --- Afternoon Gamma Squeeze Strategy -----------------------
# Secondary engine for afternoon session (12:00-14:30 IST).
# Scores entries via: Gamma Blast + BOS/Rejection + Max Pain + EMA Stack + Pattern.
# Capital is SEPARATE from morning engine (Option B: 40% of total).
# Gamma is soft-scored (not a hard gate). Works any day (not expiry-only).
AFTERNOON_ENABLED=false
AFTERNOON_CAPITAL_PCT=40
AFTERNOON_ENTRY_START_HOUR=12
AFTERNOON_ENTRY_START_MINUTE=0
AFTERNOON_ENTRY_END_HOUR=14
AFTERNOON_ENTRY_END_MINUTE=30
AFTERNOON_STOP_LOSS_PERCENT=40
AFTERNOON_TARGET_PERCENT=300
AFTERNOON_TRAIL_AFTER_MULTIPLE=1.5
AFTERNOON_TRAIL_LOCK_PERCENT=60
AFTERNOON_MAX_TRADES=1
# Minutes to wait after an afternoon exit before re-entering (0 = no cooldown).
AFTERNOON_REENTRY_COOLDOWN_MINUTES=0
AFTERNOON_TIME_STOP_MINUTES=20
AFTERNOON_SCORE_THRESHOLD=70
AFTERNOON_MAX_STRIKE_OFFSET=6
# Per-instrument enable flags (override AFTERNOON_ENABLED):
# SENSEX_AFTERNOON_ENABLED=true
# NIFTY_AFTERNOON_ENABLED=true
